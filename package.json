{
  "name": "unwrite",
  "version": "0.2.0",
  "description": "Undo one thing Claude Code did, without undoing everything after it.",
  "license": "MIT",
  "type": "commonjs",
  "keywords": [
    "claude-code",
    "claude",
    "agent",
    "undo",
    "revert",
    "hooks",
    "three-way-merge",
    "ai",
    "blame"
  ],
  "bin": {
    "unwrite": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test tests/blame.test.ts tests/diff.test.ts tests/integrity.test.ts tests/revert.test.ts tests/search.test.ts tests/settings.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^12.1.0",
    "node-diff3": "^3.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BillyBobMcgee/unwrite.git"
  },
  "homepage": "https://github.com/BillyBobMcgee/unwrite#readme",
  "bugs": {
    "url": "https://github.com/BillyBobMcgee/unwrite/issues"
  }
}
